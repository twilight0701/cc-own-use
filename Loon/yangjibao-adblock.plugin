#!name=养基宝去广告
#!desc=去开屏：改写广告配置响应关闭 splash 开关并清空开屏广告位；拦截广告上报、试玩广告资源与广告日志域名
#!author=twilight0701
#!homepage=https://github.com/twilight0701/cc-own-use

[Rule]
DOMAIN,guanggao-prod.cn-shanghai.log.aliyuncs.com,REJECT

[URL Rewrite]
^https?:\/\/app-api\.yangjibao\.com\/content\/v1\/ad\/events(?:\?.*)?$ url reject
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/play-comp\/playable-component-sdk\/package\.ugen\.json(?:\?.*)?$ url reject

[Script]
http-response ^https?:\/\/app-api\.yangjibao\.com\/content\/v1\/ad\/config(?:\?.*)?$ script-path=https://raw.githubusercontent.com/twilight0701/cc-own-use/main/Loon/yangjibao-ad.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% app-api.yangjibao.com, lf-cdn-tos.bytescm.com
